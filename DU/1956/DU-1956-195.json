  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ZDROWIA z dnia 13 września 1956 r. w sprawie zaliczenia niektórych substancji do środków odurzających. Na podstawie art. 5 ust. 2 ustawy z dnia 8 stycznia 1951 r. o tarty farmaceutycznych i odurzających oraz artykułach sanitarnych (Dz. U. Nr 1, poz, 4) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Do środków odurzających zalicza się następujące substancje:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "metylomorfina (kodeina),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "etylomorfina (której chlorowodorkiem jest Dionin),.",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_1/pkt_3",
     "text": "inne etery morfiny,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_1/pkt_4",
     "text": "dwuhydrokodeina (której winianem jest Paracodin),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_1/pkt_5",
     "text": "acetylodwuhydrokodeina,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_1/pkt_6",
     "text": "1-metylo-4 - (3-hydroksyfenylo) - 4-propionylopiperydyna (której chlorowodorkiem jest Cliradon), 4",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_1/pkt_7",
     "text": "ester etylowy kwasu 1-metylo-4-(3-hydroksyfenylo)-piperydyno-4-karboksylowego (Bemidone), w",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_1/pkt_8",
     "text": "propionian 1,3-dwumetylo-4-fenylo-4-hydroksypiperydyny (Alphaprodine),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_1/pkt_9",
     "text": "octan 1,3-dwumetylo-4-fenylo-4-hydroksymetylopiperydyny (Betaprodine),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_1/pkt_10",
     "text": "4,4+dwufenylo-5-metylo-6-dwumetyloaminoheksa non-3 (Isomóthadone),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "11",
     "path": "par_1/pkt_11",
     "text": "4,4-dwufenylo-6-4wumetyloaminoheptanol-3 (Methadone),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "12",
     "path": "par_1/pkt_12",
     "text": "alfa-6-dwumetyloamino-4,4-dwufenylo-heptanol-3,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "13",
     "path": "par_1/pkt_13",
     "text": "4,4-dwufenylo-6-4wumetyloamino-3-acetoksyheptan (Ace-- tylomethadol),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "14",
     "path": "par_1/pkt_14",
     "text": "alfa-6-dwumetyloamino-4,4-dwufenylo-3-acetoksyheptan (Alfa-acetylomethadol),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "15",
     "path": "par_1/pkt_15",
     "text": "beta-6-dwumetyloamino-4,4-dwufenylo-3-acetoksyheptan (Beta-acetylomethadol), ,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "16",
     "path": "par_1/pkt_16",
     "text": "beta-1-metylo-3-etylo-4-fenylo-4-propionoksypiperydyna (Meprodine),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "17",
     "path": "par_1/pkt_17",
     "text": "D. L-3-hydroksy-N-metylomorfinan (Racemorphan),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "18",
     "path": "par_1/pkt_18",
     "text": "L-3-hydroksy-N-metylomorfinan (Levorphane),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "19",
     "path": "par_1/pkt_19",
     "text": "D. L-metoksy-3-N-metylomorfinan (Racemethorphane),",
     "children": []
    },
    {
     "type": "pkt",
     "num": "20",
     "path": "par_1/pkt_20",
     "text": "L-metoksy-3-N-metylomorfinan (Levomethorphan), :",
     "children": [
      {
       "type": "text",
       "text": "dw tył ino-3-bis-(tienylo-2)-1 t-buten-"
      }
     ]
    },
    {
     "type": "pkt",
     "num": "2h",
     "path": "par_1/pkt_2h",
     "text": "awamety baa naszła bla li",
     "children": []
    },
    {
     "type": "pkt",
     "num": "22",
     "path": "par_1/pkt_22",
     "text": "etylometyloamino-3-bis-(tienylo-2)-1,1-buten-1,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "23",
     "path": "par_1/pkt_23",
     "text": "sole środków wymienionych w pkt 1 — 22 oraz mieszaniny zawierające te środki i ich sole.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
