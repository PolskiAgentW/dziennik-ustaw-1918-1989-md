  {
   "type": "text",
   "text": "ROZPORZĄDZENIE RADY MINISTRÓW"
  },
  {
   "type": "text",
   "text": "z dnia 3 czerwca 1953 r."
  },
  {
   "type": "text",
   "text": "w sprawie artykułów i usług, których ceny, opłaty lub stawki taryfowe albo wytyczne dla ich ustalenia określa . Rada Ministrów."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 1 ust. 2 dekretu z dnia 3 czerwca _ 1953 r. o ustałaniu cen, opłat i stawek taryfowych (Dz. U. Nr 31, poz. 122) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Rada Ministrów ustala ceny detaliczne w obrocie przedsiębiorstw handlowych lub wytyczne dla ustalenia tych cen dla następujących artykułów powszechnego użytku:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_1/pkt_1",
     "text": "mąki i chleba oraz przetworów zbożowych i mącznych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_1/pkt_2",
     "text": "mięsa i podstawowych przetworów mięsnych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_1/pkt_3",
     "text": "ryb,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_1/pkt_4",
     "text": "nabiału, drobiu i jaj,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_1/pkt_5",
     "text": "ziemniaków konsumpcyjnych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_1/pkt_6",
     "text": "tłuszczów jadalnych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_1/pkt_7",
     "text": "cukru i soli,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_1/pkt_8",
     "text": "spirytusu konsumpcyjnego, wódek czystych i podsta- „„w owych gatunków piwa,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_1/pkt_9",
     "text": "mydła i proszku do prania,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_1/pkt_10",
     "text": "papierosów i zapałek,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "11",
     "path": "par_1/pkt_11",
     "text": "pasz treściwych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "12",
     "path": "par_1/pkt_12",
     "text": "węgla, drewna opałowego i nafty,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "13",
     "path": "par_1/pkt_13",
     "text": "elektryczności i gazu,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "14",
     "path": "par_1/pkt_14",
     "text": "dzienników.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Rada Ministrów ustala podstawowe stawki taryfowe i opłaty za następujące usługi i świadczenia:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_2/pkt_1",
     "text": "stawki taryfowe za przewóz osób i bagażu w ko- 4 munikacji kolejowej, tramwajowej, trolejbusowej, autobusowej, lotniczej oraz wodnej śródlądowej, jak również stawki taryfowe za przewozy wojskowe.",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_2/pkt_2",
     "text": "stawki taryfowe pocztowe, telefoniczne, telegraficzne, radiofoniczne i radiokomunikacyjne,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_2/pkt_3",
     "text": "opłaty za usługi lecznictwa zamkniętego i usługi uzdrowiskowe,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_2/pkt_4",
     "text": "opłety za wczasy pracownicze, ‘.",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_2/pkt_5",
     "text": "opłaty wstępu do teatrów, oper, filharmonii, cyrków i kin, ‘",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_2/pkt_6",
     "text": "opłaty za przemiał zbóż,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_2/pkt_7",
     "text": "opłaty za ubój usługowy żywca,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_2/pkt_8",
     "text": "opłaty za wypiek chleba,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "9",
     "path": "par_2/pkt_9",
     "text": "opłaty za usługi państwowych ośrodków maszyno= wych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "10",
     "path": "par_2/pkt_10",
     "text": "opłaty za elektryfikację wsi.",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rada Ministrów ustala ceny zakupu wszystkich artykułów nabywanych w ramach dostaw obowiązkowych i kontraktacji.",
   "children": []
  },
  {
   "type": "par",
   "num": "4",
   "path": "par_4",
   "text": "Rada Ministrów ustala ceny sprzedażne następujących artykułów dla produkcji rolnej:",
   "children": [
    {
     "type": "pkt",
     "num": "1",
     "path": "par_4/pkt_1",
     "text": "zbóż siewnych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "2",
     "path": "par_4/pkt_2",
     "text": "nasion roślin przemysłowych,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "3",
     "path": "par_4/pkt_3",
     "text": "nawozów sztucznych,",
     "children": []
    }
   ]
  },
  {
   "type": "par",
   "num": "5",
   "path": "par_5",
   "text": "Wykonanie rozporządzenia porucza się Prezesowi Rady Ministrów, Przewodniczącemu Państwowej Komisji Planowania Gospodarczego i właściwym niinistrom.",
   "children": []
  },
  {
   "type": "par",
   "num": "6",
   "path": "par_6",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Prezes Rady Ministrów: B. Bierut"
  }
 ],
