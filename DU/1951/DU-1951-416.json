       "text": "mechaniki teoretycznej,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "9",
       "path": "par_6/ust_2/pkt_9",
       "text": "fizyki doświadczalnej I,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "10",
       "path": "par_6/ust_2/pkt_10",
       "text": "fizyki doświadczalnej II,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "11",
       "path": "par_6/ust_2/pkt_11",
       "text": "fizyki doświadczalnej III,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "12",
       "path": "par_6/ust_2/pkt_12",
       "text": "fizyki teoretycznej,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "13",
       "path": "par_6/ust_2/pkt_13",
       "text": "krystalografii oraz",
       "children": []
      },
      {
       "type": "pkt",
       "num": "14",
       "path": "par_6/ust_2/pkt_14",
       "text": "nie związany z żadną katedrą zakład naukowy: Obserwatorium Astronomiczne.",
       "children": []
      }
     ]
    },
    {
     "type": "ust",
     "num": "3",
     "path": "par_6/ust_3",
     "text": "W skład Wydziału Chemicznego wchodzą następujące katedry wraz z połączonymi z nimi zakładami naukowymi: . j",
     "children": [
      {
       "type": "pkt",
       "num": "1",
       "path": "par_6/ust_3/pkt_1",
       "text": "chemii nieorganicznej,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "2",
       "path": "par_6/ust_3/pkt_2",
       "text": "chemii organicznej,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "3",
       "path": "par_6/ust_3/pkt_3",
       "text": "chemii fizycznej,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "4",
       "path": "par_6/ust_3/pkt_4",
       "text": "chemii nieorganicznej I,",
       "children": [
        {
         "type": "text",
         "text": "Pcz. 416 i 417"
        }
       ]
      },
      {
       "type": "pkt",
       "num": "5",
       "path": "par_6/ust_3/pkt_5",
       "text": "chemii organicznej II,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "6",
       "path": "par_6/ust_3/pkt_6",
       "text": "technologii przemysłu nieorganicznego,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "7",
       "path": "par_6/ust_3/pkt_7",
       "text": "technologii przemysłu organicznego,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "8",
       "path": "par_6/ust_3/pkt_8",
       "text": "technologii przemysłów rolnych,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "9",
       "path": "par_6/ust_3/pkt_9",
       "text": "technologii nafty i paliw płynnych,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "10",
       "path": "par_6/ust_3/pkt_10",
       "text": "fototechniki,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "11",
       "path": "par_6/ust_3/pkt_11",
       "text": "maszynoznawstwa chemicznego,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "12",
       "path": "par_6/ust_3/pkt_12",
       "text": "inżynierii chemicznej,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "13",
       "path": "par_6/ust_3/pkt_13",
       "text": "technologii materiałów wybuchowych,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "14",
       "path": "par_6/ust_3/pkt_14",
       "text": "ceramiki,",
       "children": []
      },
      {
       "type": "pkt",
       "num": "15",
       "path": "par_6/ust_3/pkt_15",
       "text": "chemii i technologii węgla brunatnego.",
       "children": []
      }
     ]
    }
   ]
  },
  {
   "type": "par",
   "num": "7",
   "path": "par_7",
   "text": "Wydział Chemiczny Uniwersytetu Wrocławskiego wraz z wymienionymi w § 6 ust, 3 katedrami i połączonymi z nimi zakładami naukowymi przenosi się do Politechniki Wrocławskiej.",
   "children": []
  },
  {
   "type": "par",
   "num": "8",
   "path": "par_8",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia z mocą od dnia 1 września 1951 r. z wyjątkiem przepisów wynikających z § 5 pkt 1, które obowiązują od dnia 1 października 1950 r.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Szkół Wyższych i Nauki: A. Rapacki"
  }
 ],
