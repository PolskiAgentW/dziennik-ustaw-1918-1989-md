  {
   "type": "text",
   "text": "ROZPORZĄDZENIE MINISTRA ZDROWIA I OPIEKI SPOŁECZNEJ"
  },
  {
   "type": "text",
   "text": "z dnia 27 kwietnia 1966 r."
  },
  {
   "type": "text",
   "text": "w sprawie ustalenia wykazu chorób o dłuższym okresie wylęgania."
  },
  {
   "type": "text",
   "text": "Na podstawie art. 117 ust. 3 ustawy z dnia 28 marca 1933 r. o ubezpieczeniu społecznym (Dz. U. Nr 54; poz. 396 z późniejszymi zmianami) zarządza się, co następuje:"
  },
  {
   "type": "par",
   "num": "1",
   "path": "par_1",
   "text": "Ustala się wykaz chorób o dłuższym okresie wylęgania stanowiący załącznik do rozporządzenia.",
   "children": []
  },
  {
   "type": "par",
   "num": "2",
   "path": "par_2",
   "text": "Traci moc rozporządzenie Ministra Opieki Społecznej z dnia 28 grudnia 1933 r. o ustaleniu wykazu chorób o dłuższym okresie wylęgania (Dz. U. Nr 103, poz. 813).",
   "children": []
  },
  {
   "type": "par",
   "num": "3",
   "path": "par_3",
   "text": "Rozporządzenie wchodzi w życie z dniem ogłoszenia.",
   "children": []
  },
  {
   "type": "signature",
   "text": "Minister Zdrowia i Opieki Społecznej: J. Sztachelski"
  },
  {
   "type": "note",
   "text": "[Strona 2 PDF jest skanem. Tekst poniżej odczytał OCR (tesseract 5.5.0, pol+eng), a nie warstwa tekstowa PDF. Może zawierać błędy i pomija grafikę. Wiążący jest PDF.]"
  },
  {
   "type": "text",
   "text": "kaś"
  },
  {
   "type": "text",
   "text": "Dziennik Ustaw Nr 16 Pos. 102, 163 i 104"
  }
 ],
