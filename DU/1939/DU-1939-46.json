{
 "eli": "DU/1939/46",
 "title": "Rozporządzenie Rady Ministrów z dnia 24 stycznia 1939 r. o zakazie używania francuskich nazw regionalnych dla produktów winnych.",
 "converter": "eli2md 0.6.49",
 "source_pdf": "https://api.sejm.gov.pl/eli/acts/DU/1939/46/text.pdf",
 "body": [
  {
