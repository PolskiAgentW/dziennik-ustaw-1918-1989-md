    }
   ]
  },
  {
   "type": "ust",
   "num": "112",
   "path": "ust_112",
   "text": "Ryjówki (Soricidae) — wszystkie gatunki.",
   "children": []
  },
  {
   "type": "ust",
   "num": "113",
