     "children": []
    },
    {
     "type": "pkt",
     "num": "12",
     "path": "par_5/pkt_12",
     "text": "referenta i starszego referenta,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "13",
     "path": "par_5/pkt_13",
     "text": "maszynistki i starszej maszynistki. § 6. Stosunek: pracy na podstawie mianowania nawiązuje się z urzędnikami państwowymi na następujących stanowiskach w okręgowych komisjach arbitrażowych:",
     "children": []
    },
    {
     "type": "pkt",
     "num": "1",
