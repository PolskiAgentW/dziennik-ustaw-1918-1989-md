    },
    {
     "type": "pkt",
     "num": "4",
     "path": "par_5/pkt_4",
     "text": "komornika sądowego,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "5",
     "path": "par_5/pkt_5",
     "text": "rewidenta, . '",
     "children": []
    },
    {
     "type": "pkt",
     "num": "6",
     "path": "par_5/pkt_6",
     "text": "inspektora i starszego inspektora,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "7",
     "path": "par_5/pkt_7",
     "text": "radcy i starszego radcy,",
     "children": []
    },
    {
     "type": "pkt",
     "num": "8",
     "path": "par_5/pkt_8",
     "text": "sekretarza sądowego,",
     "children": []
